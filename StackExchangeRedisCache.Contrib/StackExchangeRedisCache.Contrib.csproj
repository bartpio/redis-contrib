<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AnalysisMode>All</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Authors>Bart Piotrowski</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <Description>Allows for Redis CommandFlags used during IDistributedCache operations to be tweaked, facilitating read replica support and Fire-and-Forget mode.</Description>
    <Copyright>(c) 2026 Bart Piotrowski and Contributors</Copyright>
    <Version>3.10015.13230</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>wrap Microsoft.Extensions.Caching.StackExchangeRedis 10.0.15 and StackExchange.Redis 2.13.23</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/bartpio/redis-contrib</RepositoryUrl>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.15" />
    <PackageReference Include="StackExchange.Redis" Version="2.13.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StackExchangeRedisCache.Contrib.SourceGenerators\StackExchangeRedisCache.Contrib.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Internal\Dummies\" />
  </ItemGroup>
</Project>
